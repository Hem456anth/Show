<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV launcher banner (320x180 dp): the Show mark centred on white, like the phone icon. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="#FFFFFFFF" /></shape></item>
    <item android:drawable="@drawable/ic_show_mark" android:gravity="center" android:width="110dp" android:height="110dp" />
</layer-list>
